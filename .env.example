# Java/Spring Boot backend. All credentials stay server-side.
# One SerpApi account key for all search engines: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
# Optional Groq place ranking: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Backend serves both API and the built React website.
PORT=8080
HOST=127.0.0.1
DATA_DIR=.data
SESSION_SECRET=
COOKIE_SECURE=false
# React Vite development origin. Production same-origin requests need no change.
FRONTEND_ORIGIN=http://localhost:3000

# Open-Meteo weather is integrated; the free non-commercial endpoint needs no key.
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=
# Paid Open-Meteo: use https://customer-api.open-meteo.com/v1/forecast above
# and put your Open-Meteo subscription key in WEATHER_API_KEY.
